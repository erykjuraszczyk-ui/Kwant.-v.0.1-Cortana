PKK_DB_PATH=data/pkk.sqlite3
PKK_STALE_AFTER_SECONDS=5
PKK_MOVEMENT_THRESHOLD=0.03
PKK_MAX_OBJECTS=2000
PKK_MAX_OBSERVATIONS=100000
PKK_MAX_EVENTS=20000

# PKK 0.9 dialogue provider: rules (default/local), ollama, openai_compatible
PKK_CHAT_PROVIDER=rules
PKK_CHAT_BASE_URL=
PKK_CHAT_MODEL=
PKK_CHAT_API_KEY=
PKK_CHAT_TIMEOUT_SECONDS=35
