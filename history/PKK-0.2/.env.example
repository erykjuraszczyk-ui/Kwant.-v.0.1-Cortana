# Model is downloaded automatically on first detection if no local weights file is supplied.
PKK_MODEL=yolo26n.pt
# Start with CPU. For a CUDA-enabled PyTorch install, change to 0 if a supported GPU exists.
PKK_DEVICE=cpu
# Model score threshold; this is not a calibrated probability.
PKK_CONFIDENCE=0.25
PKK_MAX_DETECTIONS=100
PKK_LOG_LEVEL=INFO
